<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ThermalTuner.Monitor</RootNamespace>
    <AssemblyName>ThermalTuner.Monitor</AssemblyName>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThermalTuner.Core\ThermalTuner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与主程序保持一致：0.9.6+（PawnIO 后端）。Monitor 只读遥测，不涉及 MSR 写入。 -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

</Project>
