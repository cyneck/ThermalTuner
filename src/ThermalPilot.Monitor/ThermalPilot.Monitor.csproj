<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ThermalPilot.Monitor</RootNamespace>
    <AssemblyName>ThermalPilot.Monitor</AssemblyName>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThermalPilot.Core\ThermalPilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与主程序保持一致：必须用 0.9.4（WinRing0，Ring0.ReadMsr/WriteMsr 可读写 MSR）。
         0.9.6 起后端换 PawnIO，随包 IntelMSR 模块只有 ioctl_read_msr（只读），禁止升级。 -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

</Project>
