<UserControl x:Class="ThermalTuner.App.Views.TuningPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.5*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左：意图表达 -->
    <StackPanel Grid.Column="0" Margin="0,0,12,0">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ProfileCardTitle, Mode=OneWay}" Style="{StaticResource H2}" />
              <Border Style="{StaticResource TipBadge}"
                      ToolTip="点选档位会重算一次并给出写入计划；有写入权限时会立即改写功耗上限。之后由调度器按 1W 小步、升档冷却低频微调。档位代表倾向，不是固定瓦数。">
                <TextBlock Style="{StaticResource TipGlyph}" />
              </Border>
            </StackPanel>
            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Margin="0">
              <TextBlock Style="{StaticResource Mono}" FontSize="11">
                <Run Text="当前 " /><Run Text="{Binding TuningModeText, Mode=OneWay}" />
              </TextBlock>
            </Border>
          </Grid>

          <TextBlock Text="{Binding ProfileCardHint, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,6,0,10" />

          <UniformGrid Columns="3">
            <RadioButton Style="{StaticResource ModeCard}" GroupName="mode" Tag="silent"
                         IsChecked="{Binding IsSilent, Mode=OneWay}" Click="Mode_Click" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="静音优先" Style="{StaticResource H2}" />
                <TextBlock Text="天花板 85°C" Style="{StaticResource Mono}" Margin="0,6,0,0" FontSize="11" />
                <TextBlock Text="办公、夜间" Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0" />
              </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModeCard}" GroupName="mode" Tag="balanced"
                         IsChecked="{Binding IsBalanced, Mode=OneWay}" Click="Mode_Click" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="均衡" Style="{StaticResource H2}" />
                <TextBlock Text="天花板 88°C" Style="{StaticResource Mono}" Margin="0,6,0,0" FontSize="11" />
                <TextBlock Text="默认推荐" Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0" />
              </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModeCard}" GroupName="mode" Tag="performance"
                         IsChecked="{Binding IsPerformance, Mode=OneWay}" Click="Mode_Click">
              <StackPanel>
                <TextBlock Text="性能优先" Style="{StaticResource H2}" />
                <TextBlock Text="天花板 92°C" Style="{StaticResource Mono}" Margin="0,6,0,0" FontSize="11" />
                <TextBlock Text="编译、渲染" Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0" />
              </StackPanel>
            </RadioButton>
          </UniformGrid>

          <Border Background="{StaticResource BgSubtle}" CornerRadius="6" Padding="10,7" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{Binding ModeStatusText, Mode=OneWay}" Style="{StaticResource Label}"
                         FontSize="11" TextWrapping="Wrap" ToolTip="{Binding MonitorHintText, Mode=OneWay}" />
              <TextBlock Text="{Binding LastWriteText, Mode=OneWay}" Style="{StaticResource Label}"
                         FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TextTertiary}" />
            </StackPanel>
          </Border>

          <Border x:Name="OutcomeBanner" Background="{StaticResource AccentSoft}"
                  BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="6"
                  Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="OutcomeText" Style="{StaticResource Body}" FontSize="11"
                       Foreground="{StaticResource AccentDeep}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="温度天花板" Style="{StaticResource H2}" />
              <Border Style="{StaticResource TipBadge}"
                      ToolTip="天花板决定「多热才降功耗」。调低更凉更安静；调高能更久保持高频，但更接近硬件保护点。切换档位会重置为该档预设值。">
                <TextBlock Style="{StaticResource TipGlyph}" />
              </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Right"
                       FontSize="16" Foreground="{StaticResource Accent}"
                       Text="{Binding CeilingText, Mode=OneWay}" />
          </Grid>

          <Slider x:Name="CeilingSlider" Margin="0,14,0,0" Minimum="40" Maximum="95"
                  TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding CeilingC, Mode=OneWay}"
                  ValueChanged="Ceiling_ValueChanged" />

          <Grid Margin="0,2,0,0">
            <TextBlock Text="40°C" Style="{StaticResource Label}" FontSize="11" />
            <TextBlock Style="{StaticResource Label}" FontSize="11" HorizontalAlignment="Right">
              <Run Text="安全上限 " /><Run Text="{Binding Limits.MaxSafeCeiling, Mode=OneWay, StringFormat={}{0:F0}}" /><Run Text="°C" />
            </TextBlock>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="平台约束" Style="{StaticResource H2}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="24" />
              <RowDefinition Height="24" />
              <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource Mono}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="平台" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center">
              <Run Text="{Binding PlatformText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FormText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="2" Text="功耗区间" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PlRangeText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 右：热模型与标定 -->
    <StackPanel Grid.Column="1">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="在线热模型" Style="{StaticResource H2}" />
            <Border Style="{StaticResource TipBadge}"
                    ToolTip="用真实温度与功耗拟合热阻，预测稳态温度。预测式：轻载基线温度 +（目标功耗 − 基线功耗）× 热阻；两个数都可手工复算。">
              <TextBlock Style="{StaticResource TipGlyph}" />
            </Border>
          </StackPanel>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="估计热阻" Style="{StaticResource Label}" FontSize="11" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding RthText, Mode=OneWay}" Style="{StaticResource Metric}" FontSize="22" />
                <TextBlock Text=" K/W" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,3" />
              </StackPanel>
              <TextBlock Text="{Binding RthSourceText, Mode=OneWay}" Style="{StaticResource Label}"
                         FontSize="11" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1">
              <TextBlock Text="预测稳态" Style="{StaticResource Label}" FontSize="11" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding PredictedText, Mode=OneWay}" Style="{StaticResource Metric}" FontSize="22" />
                <TextBlock Text=" °C" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,3" />
              </StackPanel>
              <TextBlock Text="{Binding PredictedBasisText, Mode=OneWay}" Style="{StaticResource Label}"
                         FontSize="11" Margin="0,2,0,0" />
              <TextBlock Text="{Binding PredictedBaselineText, Mode=OneWay}" Style="{StaticResource Label}"
                         FontSize="10" Margin="0,1,0,0" Foreground="{StaticResource TextTertiary}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding ThermalCapText, Mode=OneWay}" Style="{StaticResource Hint}"
                     Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="一键标定" Style="{StaticResource H2}" />
          <TextBlock Text="{Binding CalibrationText, Mode=OneWay}" Style="{StaticResource Hint}"
                     Margin="0,4,0,10" />

          <ProgressBar Height="4" Maximum="100" Value="{Binding CalibrationProgress, Mode=OneWay}"
                       Foreground="{StaticResource Accent}" Background="{StaticResource BgSubtle}"
                       BorderThickness="0" Margin="0,0,0,12" />

          <StackPanel Orientation="Horizontal">
            <Button x:Name="CalibrateButton" Content="开始两段式标定" Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanCalibrate, Mode=OneWay}"
                    ToolTip="{Binding CalibrationBlockedReason, Mode=OneWay}"
                    ToolTipService.ShowOnDisabled="True"
                    Click="Calibrate_Click" />
            <Button Content="取消" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Click="CancelCalibration_Click" />
            <Button Content="以管理员重启" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Visibility="{Binding ElevationHintVisibility, Mode=OneWay}"
                    ToolTip="读取真实功耗与硬件参数需要管理员权限"
                    Click="RestartElevated_Click" />
          </StackPanel>

          <!-- 置灰原因常驻：WPF 禁用控件弹不出 ToolTip，不能只靠悬停 -->
          <TextBlock Text="{Binding CalibrationGateHint, Mode=OneWay}"
                     Visibility="{Binding CalibrationGateVisibility, Mode=OneWay}"
                     Style="{StaticResource Hint}" Margin="0,8,0,0"
                     Foreground="{StaticResource Warn}" />

          <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                     Text="空载基线 12s → 满载升温到温度平台 → 稳态采样 10s，全程约 1–3 分钟；期间风扇可能变响。" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="当前决策参数" Style="{StaticResource H2}" />
            <Border Style="{StaticResource TipBadge}"
                    ToolTip="智能链路只改写功耗上限（持续 / 短时），短时功耗时长保持原值；能效偏好与风扇只是演算，不写入。手工微调页可以改写时长与电压偏移；本机读不到的项在那里显示 -- 并禁用。写入成功只代表读回一致，功耗与频率真正收敛需要几十秒。">
              <TextBlock Style="{StaticResource TipGlyph}" />
            </Border>
          </StackPanel>

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
              <TextBlock Text="目标功耗" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="13">
                <Run Text="{Binding Pl1Text, Mode=OneWay}" /><Run Text=" W" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1">
              <TextBlock Text="短时上限" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="13">
                <Run Text="{Binding Pl2Text, Mode=OneWay}" /><Run Text=" W" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
              <TextBlock Text="短时时长" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="13">
                <Run Text="{Binding TauText, Mode=OneWay}" /><Run Text=" s" />
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0"
                        ToolTip="决策算法给出的能效偏好建议值。智能链路从不下发，本机该参数也只读。">
              <TextBlock Text="能效偏好（仅演算）" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Text="{Binding EppText, Mode=OneWay}" Style="{StaticResource Mono}" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                        ToolTip="决策树给的建议转速，只用于演算与展示；软件从不写风扇 / EC / PWM，实际转速由 BIOS 按温度曲线控制。">
              <TextBlock Text="风扇（仅演算）" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="13">
                <Run Text="{Binding FanText, Mode=OneWay}" /><Run Text=" %" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
              <TextBlock Text="档位" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Text="{Binding ProfileLabel, Mode=OneWay}" Style="{StaticResource Mono}" FontSize="13" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
