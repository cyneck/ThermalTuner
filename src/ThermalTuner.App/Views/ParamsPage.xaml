<UserControl x:Class="ThermalTuner.App.Views.ParamsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 头部 -->
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <Grid>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="手工微调 · CPU 功耗参数" Style="{StaticResource H2}" />
            <Border x:Name="ModeChip" Style="{StaticResource Chip}" Background="{StaticResource BgSubtle}"
                    Margin="10,0,0,0">
              <TextBlock x:Name="ModeChipText" Style="{StaticResource Mono}" FontSize="11" Text="只读" />
            </Border>
            <Border x:Name="MsrChip" Style="{StaticResource Chip}" Background="{StaticResource WarnSoft}"
                    BorderBrush="{StaticResource Warn}" ToolTip="{Binding MsrDetail}">
              <TextBlock x:Name="MsrChipText" Style="{StaticResource Mono}" FontSize="11"
                         Foreground="{StaticResource Warn}"
                         Text="{Binding MsrSummary, Mode=OneWay}" />
            </Border>
          </StackPanel>
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="本页即「手工微调」：解锁后可编辑全部参数，「保存并下发」会立即写入寄存器并切换到手工模式，智能档位与决策树随即只演算、不覆盖你的值。环境自检与固件基线对照已迁到「诊断与日志」页。" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock x:Name="MsrHint" Style="{StaticResource Label}" FontSize="11"
                       Foreground="{StaticResource TextTertiary}" Text="演练模式：只校验不写硬件。" />
            <TextBlock Text="{Binding CapabilityOneLineText, Mode=OneWay}" Style="{StaticResource Mono}"
                       FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       ToolTip="{Binding CapabilityReportText, Mode=OneWay}" />
          </StackPanel>
          <TextBlock Text="{Binding TuningModeText, Mode=OneWay}" Style="{StaticResource Label}"
                     FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource TextSecondary}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="UnlockButton" Content="解锁编辑" Style="{StaticResource GhostButton}"
                  Click="Unlock_Click" />
          <Button Content="恢复默认" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                  Click="Reset_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 参数表 -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="参数" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="1" Text="当前生效（实读）" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="2" Text="待应用" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="3" Text="硬件范围" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="4" Text="为什么是这个范围" Style="{StaticResource Label}" FontSize="11" />
        </Grid>

        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,8,0,0" />
        <TextBlock Text="通用参数 · 智能标定可推荐（L2）／用户可编辑（L3）" Style="{StaticResource Label}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource AccentDeep}" />

        <!-- PL1 -->
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PL1 持续功耗" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="MSR 0x610 [14:0]" Style="{StaticResource Mono}" FontSize="10"
                       Foreground="{StaticResource TextTertiary}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center">
            <Run Text="{Binding FwPl1Text, Mode=OneWay}" /><Run Text=" W" />
          </TextBlock>
          <TextBox x:Name="Pl1Box" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="[" /><Run Text="{Binding Limits.MinPL1, Mode=OneWay}" /><Run Text=", " />
            <Run Text="{Binding Limits.MaxPL1, Mode=OneWay}" /><Run Text="] W" />
          </TextBlock>
          <TextBlock Grid.Column="4" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center"
                     TextWrapping="Wrap" Text="长期可持续的封装功耗，决定稳态温度，并间接影响 EC 自动调速的风扇噪音（软件不直写风扇）。" />
        </Grid>

        <!-- PL2 -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PL2 短时功耗" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="MSR 0x610 [46:32]" Style="{StaticResource Mono}" FontSize="10"
                       Foreground="{StaticResource TextTertiary}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center">
            <Run Text="{Binding FwPl2Text, Mode=OneWay}" /><Run Text=" W" />
          </TextBlock>
          <TextBox x:Name="Pl2Box" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="[" /><Run Text="{Binding Limits.MinPL2, Mode=OneWay}" /><Run Text=", " />
            <Run Text="{Binding Limits.MaxPL2, Mode=OneWay}" /><Run Text="] W 且 ≥ PL1" />
          </TextBlock>
          <TextBlock Grid.Column="4" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center"
                     TextWrapping="Wrap" Text="短时爆发上限，受 Tau 约束；小于 PL1 无物理意义。" />
        </Grid>

        <!-- Tau -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Tau 时间常数" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="MSR 0x610 [23:17]" Style="{StaticResource Mono}" FontSize="10"
                       Foreground="{StaticResource TextTertiary}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center">
            <Run Text="{Binding FwTauText, Mode=OneWay}" /><Run Text=" s" />
          </TextBlock>
          <TextBox x:Name="TauBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="(1+y/4)·2^x s · 建议步长 ≤128 s"
                     Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center"
                     TextWrapping="Wrap" Text="PL2 保持多久后回落到 PL1，只能取硬件编码步长。" />
        </Grid>

        <!-- EPP -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="EPP 能效偏好" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="MSR 0x774 [31:24]" Style="{StaticResource Mono}" FontSize="10"
                       Foreground="{StaticResource TextTertiary}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding FwEppText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="13" VerticalAlignment="Center" />
          <TextBox x:Name="EppBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="[0, 255] · 0=性能 255=省电" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center"
                     TextWrapping="Wrap" Text="芯片自主调频时的偏好权重，影响响应速度与瞬时功耗。" />
        </Grid>

        <!-- Min Perf (0x774 [7:0]) -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Min Perf 最低性能" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="MSR 0x774 [7:0]" Style="{StaticResource Mono}" FontSize="10"
                       Foreground="{StaticResource TextTertiary}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding FwMinPerfText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="13" VerticalAlignment="Center" />
          <TextBox x:Name="MinPerfBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="[0, 255] · 且 ≤ Max Perf" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center"
                     TextWrapping="Wrap" Text="HWP 最低性能请求，影响轻载频率与待机功耗；设得过高会阻止 CPU 降频。" />
        </Grid>

        <!-- Max Perf (0x774 [15:8]) -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Max Perf 最高性能" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="MSR 0x774 [15:8]" Style="{StaticResource Mono}" FontSize="10"
                       Foreground="{StaticResource TextTertiary}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding FwMaxPerfText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="13" VerticalAlignment="Center" />
          <TextBox x:Name="MaxPerfBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="[Min Perf, " /><Run Text="{Binding FwHwpMaxPerf, Mode=OneWay}" /><Run Text="] · 不做超频" />
          </TextBlock>
          <TextBlock Grid.Column="4" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center"
                     TextWrapping="Wrap" Text="直接限制 HWP 最高性能请求，比 PL1 更直接地压频率、功耗与温度；不得超过出厂上限。" />
        </Grid>

        <!-- Activity Window (0x774 [41:32]) -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Activity Window" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="MSR 0x774 [41:32]" Style="{StaticResource Mono}" FontSize="10"
                       Foreground="{StaticResource TextTertiary}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding FwActivityWindowText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="13" VerticalAlignment="Center" />
          <TextBox x:Name="ActivityWindowBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="[0, 1023] · 出厂 414" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center"
                     TextWrapping="Wrap" Text="EPP 偏好的平滑窗口，影响选频响应速度与瞬时功耗；数值越大越迟钝。" />
        </Grid>

        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" />
        <TextBlock Text="个性化可选微调 · 仅用户手动（L3），智能标定与应用标定一律不碰" Style="{StaticResource Label}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource Warn}" />

        <!-- 睿频倍率上限 (MSR 0x1AD) -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="睿频倍率上限" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="MSR 0x1AD 八档" Style="{StaticResource Mono}" FontSize="10"
                       Foreground="{StaticResource TextTertiary}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding FwTurboText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="13" VerticalAlignment="Center"
                     ToolTip="各活跃核心数档位的实读倍率（×100MHz），例如 38/36/35/34" />
          <TextBox x:Name="TurboBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="{Binding TurboRangeText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Text="{Binding TurboHintText, Mode=OneWay}" Style="{StaticResource Label}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>

        <!-- 电压偏移 (MSR 0x150 OC Mailbox)：个性化高风险项，需二次确认 -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Core/Cache 电压偏移" Style="{StaticResource RowText}" FontWeight="SemiBold"
                       Foreground="{StaticResource Warn}" />
            <TextBlock Text="MSR 0x150 · 可选" Style="{StaticResource Mono}" FontSize="10"
                       Foreground="{StaticResource TextTertiary}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center">
            <Run Text="{Binding AppliedVoltageMv, Mode=OneWay}" /><Run Text=" mV" />
          </TextBlock>
          <TextBox x:Name="VoltageBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="[-150, 0] mV · 禁止加压" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center"
                     TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                     ToolTip="{Binding CpuCapabilityText, Mode=OneWay}"
                     Text="降压能实际降低温度与功耗，可能让标定推荐值变化；但并非所有 CPU 可写（10 代+/非 Intel/BIOS 锁）。写入易失、重启即恢复，仍可能造成不稳定或蓝屏，需二次确认。" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 校验与操作 -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="14,10">
        <StackPanel>
          <TextBlock Text="校验结果" Style="{StaticResource Label}" FontSize="11" />
          <ItemsControl x:Name="ViolationList" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="DiffText" Style="{StaticResource Mono}" FontSize="11" Margin="0,6,0,0"
                     Foreground="{StaticResource TextSecondary}" Text="无改动" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
        <Button x:Name="ApplyButton" Content="保存并下发（演练）" Style="{StaticResource PrimaryButton}"
                MinWidth="110" IsEnabled="False" Click="Apply_Click" />
        <Button Content="撤销" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Revert_Click" />
        <Button Content="恢复原值" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                Click="Restore_Click" />
      </StackPanel>
    </Grid>

    <!-- 结果横幅 -->
    <Border x:Name="OutcomeBanner" Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0"
            Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
            VerticalAlignment="Top" Visibility="Collapsed">
      <TextBlock x:Name="OutcomeText" Style="{StaticResource Body}" Foreground="{StaticResource AccentDeep}"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
