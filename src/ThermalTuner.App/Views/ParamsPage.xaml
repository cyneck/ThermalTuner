<UserControl x:Class="ThermalTuner.App.Views.ParamsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 头部：左右两列，说明文字不再被按钮压住 -->
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="功耗与选频参数" Style="{StaticResource H2}" />
            <Border x:Name="ModeChip" Style="{StaticResource Chip}" Background="{StaticResource BgSubtle}"
                    Margin="10,0,0,0">
              <TextBlock x:Name="ModeChipText" Style="{StaticResource Mono}" FontSize="11" Text="只读" />
            </Border>
            <Border x:Name="MsrChip" Style="{StaticResource Chip}" Background="{StaticResource WarnSoft}"
                    BorderBrush="{StaticResource Warn}" ToolTip="{Binding MsrDetail}">
              <TextBlock x:Name="MsrChipText" Style="{StaticResource Mono}" FontSize="11"
                         Foreground="{StaticResource Warn}"
                         Text="{Binding MsrSummary, Mode=OneWay}" />
            </Border>
          </StackPanel>

          <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                     Text="解锁后可逐项编辑，「保存并下发」会立即写入并切换到手工模式；之后智能档位只演算，不覆盖你的值。" />

          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock x:Name="MsrHint" Style="{StaticResource Hint}"
                       Text="演练模式：只校验不写硬件。" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CapabilityOneLineText, Mode=OneWay}" Style="{StaticResource Mono}"
                       FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding CapabilityReportText, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="UnlockButton" Content="解锁编辑" Style="{StaticResource GhostButton}"
                  Click="Unlock_Click" />
          <Button Content="恢复默认" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                  ToolTip="按当前档位比例填入短时上限 / 短时时长 / 能效偏好；持续上限、睿频、性能档与电压回到实测值或零。"
                  Click="Reset_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 参数表 -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="参数" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="1" Text="当前实读" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="2" Text="待应用" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="3" Text="合法范围" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="4" Text="作用" Style="{StaticResource Label}" FontSize="11" />
        </Grid>

        <Border Style="{StaticResource Divider}" />

        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="4" Style="{StaticResource Hint}"
                     Text="读不到的项显示 -- 且不可编辑，不会用默认值顶替实测读数。" />
        </Grid>

        <TextBlock Text="通用参数 · 自动检测可给推荐，也可手动设置" Style="{StaticResource Label}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{StaticResource AccentDeep}" />

        <!-- PL1 -->
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" ToolTip="技术详情：寄存器 0x610 位 [14:0]">
            <TextBlock Text="持续功耗上限" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="长时间满载的功率上限" Style="{StaticResource Hint}" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center">
            <Run Text="{Binding FwPl1Text, Mode=OneWay}" /><Run Text=" W" />
          </TextBlock>
          <TextBox x:Name="Pl1Box" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="[" /><Run Text="{Binding Limits.MinPL1, Mode=OneWay}" /><Run Text=", " />
            <Run Text="{Binding Limits.MaxPL1, Mode=OneWay}" /><Run Text="] W" />
          </TextBlock>
          <TextBlock Grid.Column="4" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Text="决定稳态温度，间接影响风扇噪音。" />
        </Grid>

        <!-- PL2 -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" ToolTip="技术详情：寄存器 0x610 位 [46:32]">
            <TextBlock Text="短时功耗上限" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="短时爆发的功率上限" Style="{StaticResource Hint}" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center">
            <Run Text="{Binding FwPl2Text, Mode=OneWay}" /><Run Text=" W" />
          </TextBlock>
          <TextBox x:Name="Pl2Box" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="[" /><Run Text="{Binding Limits.MinPL2, Mode=OneWay}" /><Run Text=", " />
            <Run Text="{Binding Limits.MaxPL2, Mode=OneWay}" /><Run Text="] W 且不低于持续上限" />
          </TextBlock>
          <TextBlock Grid.Column="4" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Text="能维持多久由「短时功耗时长」决定。" />
        </Grid>

        <!-- Tau -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" ToolTip="技术详情：寄存器 0x610 位 [23:17]">
            <TextBlock Text="短时功耗时长" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="爆发能维持多久" Style="{StaticResource Hint}" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center">
            <Run Text="{Binding FwTauText, Mode=OneWay}" /><Run Text=" s" />
          </TextBlock>
          <TextBox x:Name="TauBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="(1+y/4)·2^x s" Style="{StaticResource Mono}" FontSize="11"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Text="超过这个时长后回落到持续功耗上限。" />
        </Grid>

        <!-- EPP -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" ToolTip="技术详情：寄存器 0x774 位 [31:24]">
            <TextBlock Text="能效偏好" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="芯片自主调频的偏好" Style="{StaticResource Hint}" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding FwEppText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="13" VerticalAlignment="Center" />
          <TextBox x:Name="EppBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="{Binding EppRangeText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Text="0 偏性能，255 偏省电。" />
        </Grid>

        <!-- Min Perf -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" ToolTip="技术详情：寄存器 0x774 位 [7:0]">
            <TextBlock Text="最低性能档" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="空闲时的最低档位" Style="{StaticResource Hint}" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding FwMinPerfText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="13" VerticalAlignment="Center" />
          <TextBox x:Name="MinPerfBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="{Binding MinPerfRangeText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Text="过高会阻止 CPU 降频。" />
        </Grid>

        <!-- Max Perf -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" ToolTip="技术详情：寄存器 0x774 位 [15:8]">
            <TextBlock Text="最高性能档" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="满载时的最高档位" Style="{StaticResource Hint}" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding FwMaxPerfText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="13" VerticalAlignment="Center" />
          <TextBox x:Name="MaxPerfBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="{Binding MaxPerfRangeText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Text="直接压低频率，比降功耗更硬。" />
        </Grid>

        <!-- Activity Window -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" ToolTip="技术详情：寄存器 0x774 位 [41:32]">
            <TextBlock Text="调频响应窗口" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="反应快慢的平滑窗口" Style="{StaticResource Hint}" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding FwActivityWindowText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="13" VerticalAlignment="Center" />
          <TextBox x:Name="ActivityWindowBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="{Binding ActivityWindowRangeText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Text="越大越迟钝，越小越灵敏。" />
        </Grid>

        <Border Style="{StaticResource Divider}" Margin="0,14,0,0" />
        <TextBlock Text="个性化微调 · 仅手动设置，自动检测不会覆盖" Style="{StaticResource Label}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource Warn}" />

        <!-- 睿频倍率 -->
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" ToolTip="技术详情：寄存器 0x1AD（按活跃核心数分八档）">
            <TextBlock Text="睿频上限" Style="{StaticResource RowText}" FontWeight="SemiBold" />
            <TextBlock Text="各核心数下的最高倍频" Style="{StaticResource Hint}" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding FwTurboText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="13" VerticalAlignment="Center"
                     ToolTip="各活跃核心数档位的实读倍率（×100MHz）；读不到时显示 --，不是默认值。" />
          <TextBox x:Name="TurboBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="{Binding TurboRangeText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Text="{Binding TurboHintText, Mode=OneWay}" Style="{StaticResource Hint}"
                     VerticalAlignment="Center" />
        </Grid>

        <!-- 电压偏移 -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" ToolTip="技术详情：寄存器 0x150（可选）">
            <TextBlock Text="核心电压偏移" Style="{StaticResource RowText}" FontWeight="SemiBold"
                       Foreground="{StaticResource Warn}" />
            <TextBlock Text="只允许降压，禁止加压" Style="{StaticResource Hint}" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center">
            <Run Text="{Binding AppliedVoltageMv, Mode=OneWay}" /><Run Text=" mV" />
          </TextBlock>
          <TextBox x:Name="VoltageBox" Grid.Column="2" Style="{StaticResource FieldBox}" IsEnabled="False"
                   TextChanged="Value_Changed" />
          <TextBlock Grid.Column="3" Text="[-150, 0] mV · 禁止加压" Style="{StaticResource Mono}"
                     FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="4" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Foreground="{StaticResource Warn}"
                     ToolTip="{Binding CpuCapabilityText, Mode=OneWay}"
                     Text="降压可降温度，但并非所有 CPU 可写；写入易失、仍需二次确认。" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 校验与操作 -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="14,10">
        <StackPanel>
          <TextBlock Text="校验结果" Style="{StaticResource Label}" FontSize="11" />
          <ItemsControl x:Name="ViolationList" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="DiffText" Style="{StaticResource Mono}" FontSize="11" Margin="0,6,0,0"
                     Foreground="{StaticResource TextSecondary}" Text="无改动" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
        <Button x:Name="ApplyButton" Content="保存并下发（演练）" Style="{StaticResource PrimaryButton}"
                MinWidth="110" IsEnabled="False" Click="Apply_Click"
                ToolTip="解锁并修改参数后可用；实际写入前会二次确认并自动备份原值。" />
        <Button Content="撤销" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                ToolTip="放弃本次未应用的修改。" Click="Revert_Click" />
        <Button Content="恢复原值" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                ToolTip="把寄存器写回启动时备份的固件值，需输入确认词。" Click="Restore_Click" />
      </StackPanel>
    </Grid>

    <!-- 结果横幅 -->
    <Border x:Name="OutcomeBanner" Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0"
            Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
            VerticalAlignment="Top" Visibility="Collapsed">
      <TextBlock x:Name="OutcomeText" Style="{StaticResource Body}" Foreground="{StaticResource AccentDeep}"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
