<UserControl x:Class="ThermalTuner.App.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左：环境体检 + 驱动 + 恢复 + 自检 + 基线 -->
    <StackPanel Grid.Column="0" Margin="0,0,12,0">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <TextBlock Text="环境体检" Style="{StaticResource H2}" />
            <Button Content="重新探测" Style="{StaticResource GhostButton}" Height="26" Padding="10,0"
                    HorizontalAlignment="Right" Click="Refresh_Click"
                    ToolTip="重新读取 CPU、平台、温度上限与传感器可用性；只读，不改任何设置。" />
          </Grid>

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="1" Text="平台" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center">
              <Run Text="{Binding PlatformText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FormText, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Grid.Row="2" Text="核心" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CoreText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Text="温度上限" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TjMaxText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="4" Text="功耗区间" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PlRangeText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="5" Text="虚拟化" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="VmText" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" Text="—" />

            <TextBlock Grid.Row="6" Text="探测备注" Style="{StaticResource Label}" VerticalAlignment="Top"
                       Margin="0,4,0,0" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding NotesText}" Style="{StaticResource Hint}"
                       Margin="0,4,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="驱动与权限" Style="{StaticResource H2}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="MSR 后端" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DriverText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="运行权限" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElevationText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Text="传感器数" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SensorCount}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Text="内存完整性" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HvciText" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" Text="—" />

            <TextBlock Grid.Row="4" Text="功耗计量" Style="{StaticResource Label}" VerticalAlignment="Top"
                       Margin="0,4,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RaplText, Mode=OneWay}" Style="{StaticResource Hint}"
                       Margin="0,4,0,0" ToolTip="{Binding RaplText, Mode=OneWay}" />
          </Grid>

          <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                  CornerRadius="6" Padding="10,7" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap"
                       Text="温度读数为空时：以管理员运行本程序，并在「环境自检报告」里安装或修复 PawnIO 驱动。" />
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="日志与数据" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="写入前备份 → 回读校验 → 失败回滚；异常退出后下次启动自动恢复。下列文件各管一件事，按用途分开存放，互不覆盖。" />
          <ItemsControl x:Name="DataFileList" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="146" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}" FontSize="11"
                             VerticalAlignment="Top" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding Purpose}" Style="{StaticResource Hint}"
                             FontSize="11" TextWrapping="Wrap" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="2" Text="{Binding State}" Style="{StaticResource Mono}"
                             FontSize="10" Margin="8,1,0,0" VerticalAlignment="Top"
                             Foreground="{StaticResource TextTertiary}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Click="OpenDataDir_Click"
                    ToolTip="备份、设置、审计日志与热事件记录都在这里；采样明细需在概览页导出。" />
            <Button Content="刷新文件状态" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Click="Refresh_Click" ToolTip="重新统计各文件的大小、行数与最后写入时间。" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <Grid>
            <TextBlock Text="环境自检报告" Style="{StaticResource H2}" VerticalAlignment="Center" />
            <Button Content="管理员重新自检" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Height="26" Padding="10,0"
                    Click="EnvCheck_Click"
                    ToolTip="以管理员复测写入能力（同值写回 / 电压回零），不改变现有参数。" />
          </Grid>
          <TextBlock x:Name="EnvCheckOutcome" Style="{StaticResource Hint}"
                     Margin="0,8,0,0" Visibility="Collapsed" />
          <TextBox Text="{Binding CapabilityReportText, Mode=OneWay}" IsReadOnly="True"
                   Height="140" Margin="0,8,0,0" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   FontFamily="Consolas" FontSize="11" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="固件基线与三层参数" Style="{StaticResource H2}" />
            <Border Style="{StaticResource TipBadge}"
                    ToolTip="出厂基线在首次启动时快照、永不覆盖；自动推荐只更新通用安全参数；手工微调由用户编辑并在开机时重放。固件默认值本身无法持久化修改。">
              <TextBlock Style="{StaticResource TipGlyph}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding FwDefaultText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding FwDivergeText, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding CalibrationLayerText, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding ManualLayerText, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 右：传感器清单 + 事件 -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="1.5*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="传感器清单" Style="{StaticResource H2}" />
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,0,8"
                     Text="原始读数，null 表示该传感器不提供此项，不是错误。" />
          <TextBox x:Name="SensorText" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0"
                   Background="{StaticResource BgSubtle}" Padding="8"
                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   Text="点击「重新探测」加载传感器列表。" />
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="事件中心" Style="{StaticResource H2}" />
              <Border Style="{StaticResource TipBadge}"
                      ToolTip="按时间倒序保留本次会话最近的事件：信息＝状态变化（模式切换、开写、标定阶段），注意＝需要留意但不影响使用（如某通道改写未生效），故障＝写入或恢复失败。只记录、不参与决策。">
                <TextBlock Style="{StaticResource TipGlyph}" />
              </Border>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}"
                       FontSize="11" Foreground="{StaticResource TextTertiary}">
              <Run Text="{Binding AlertCount, Mode=OneWay}" /><Run Text=" 条 · 本会话" />
            </TextBlock>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,0,8"
                     Text="按时间倒序；等级只区分「信息 / 注意 / 故障」，同一条只记一次。" />
          <Grid>
            <TextBlock x:Name="AlertEmpty" Style="{StaticResource Hint}" Margin="0,8,0,0"
                       Text="本次会话暂无事件。启动、切换模式、写入或标定后会自动记录。" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
              <ItemsControl ItemsSource="{Binding Alerts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" FontSize="11"
                                     Foreground="{StaticResource TextTertiary}" />
                          <Border x:Name="LevelChip" Background="{StaticResource BgSubtle}" CornerRadius="3"
                                  Padding="4,0" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LevelText" Text="{Binding LevelText}" FontSize="10"
                                       Foreground="{StaticResource TextSecondary}" />
                          </Border>
                          <TextBlock Text="{Binding Title}" Style="{StaticResource RowText}" FontSize="12"
                                     FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}"
                                   Margin="0,2,0,0" />
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Level}" Value="warn">
                        <Setter TargetName="LevelChip" Property="Background" Value="{StaticResource WarnSoft}" />
                        <Setter TargetName="LevelText" Property="Foreground" Value="{StaticResource Warn}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Level}" Value="danger">
                        <Setter TargetName="LevelChip" Property="Background" Value="{StaticResource DangerSoft}" />
                        <Setter TargetName="LevelText" Property="Foreground" Value="{StaticResource Danger}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
