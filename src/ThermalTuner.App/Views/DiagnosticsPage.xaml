<UserControl x:Class="ThermalTuner.App.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左：环境体检 + 恢复机制 -->
    <StackPanel Grid.Column="0" Margin="0,0,12,0">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <TextBlock Text="环境体检" Style="{StaticResource H2}" />
            <Button Content="重新探测" Style="{StaticResource GhostButton}" Height="26" Padding="10,0"
                    HorizontalAlignment="Right" Click="Refresh_Click" />
          </Grid>

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="1" Text="平台" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center">
              <Run Text="{Binding PlatformText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FormText, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Grid.Row="2" Text="核心" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CoreText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Text="温度上限" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TjMaxText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="4" Text="功耗区间" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PlRangeText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="5" Text="虚拟化" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="VmText" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" Text="—" />

            <TextBlock Grid.Row="6" Text="功耗计量" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RaplText, Mode=OneWay}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding RaplText, Mode=OneWay}" />

            <TextBlock Grid.Row="7" Text="探测备注" Style="{StaticResource Label}" VerticalAlignment="Top"
                       Margin="0,4,0,0" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding NotesText}" Style="{StaticResource Label}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="驱动与权限" Style="{StaticResource H2}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
              <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <TextBlock Text="硬件驱动" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DriverText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="运行权限" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElevationText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Text="传感器数" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SensorCount}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Text="内存完整性" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HvciText" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" Text="—" />
          </Grid>

          <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                  CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap"
                       Text="温度读数为空时：确认已安装 PawnIO，并以管理员身份运行。不建议关闭内存完整性换驱动可用性。" />
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="恢复机制" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="写入前备份 → 回读校验 → 失败回滚；异常退出后下次启动自动恢复。" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Click="OpenDataDir_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="环境自检报告" Style="{StaticResource H2}" />
          <TextBox Text="{Binding CapabilityReportText, Mode=OneWay}" IsReadOnly="True"
                   Height="150" Margin="0,8,0,0" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   FontFamily="Consolas" FontSize="11" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 右：传感器清单 + 事件 -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="传感器清单（LibreHardwareMonitor）" Style="{StaticResource H2}" />
          <TextBox x:Name="SensorText" DockPanel.Dock="Bottom" Margin="0,10,0,0" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0"
                   Background="{StaticResource BgSubtle}" Padding="8"
                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   Text="点击「重新探测」加载传感器列表。" />
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="事件中心" Style="{StaticResource H2}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding Alerts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" FontSize="11"
                                   Foreground="{StaticResource TextTertiary}" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowText}" FontSize="12"
                                   FontWeight="SemiBold" Margin="8,0,0,0" />
                      </StackPanel>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" FontSize="11"
                                 TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
