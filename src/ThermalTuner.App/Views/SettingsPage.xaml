<UserControl x:Class="ThermalTuner.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Margin="0,0,12,0">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="运行" Style="{StaticResource H2}" />

          <Grid Margin="0,12,0,0">
            <TextBlock Text="采样间隔" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <ComboBox x:Name="IntervalBox" Width="120" Height="30" HorizontalAlignment="Right"
                      VerticalContentAlignment="Center" SelectionChanged="Interval_Changed">
              <ComboBoxItem Content="500 ms" Tag="500" />
              <ComboBoxItem Content="1000 ms" Tag="1000" />
              <ComboBoxItem Content="2000 ms" Tag="2000" />
            </ComboBox>
          </Grid>

          <Grid Margin="0,12,0,0">
            <TextBlock Text="升档冷却" Style="{StaticResource Label}" VerticalAlignment="Center"
                       ToolTip="只约束升档写入，让 RAPL 按 Tau 窗口收敛；降档与高温降档立即放行" />
            <ComboBox x:Name="CooldownBox" Width="120" Height="30" HorizontalAlignment="Right"
                      VerticalContentAlignment="Center" SelectionChanged="Cooldown_Changed">
              <ComboBoxItem Content="5 s" Tag="5" />
              <ComboBoxItem Content="10 s" Tag="10" />
              <ComboBoxItem Content="15 s" Tag="15" />
              <ComboBoxItem Content="20 s（默认）" Tag="20" />
              <ComboBoxItem Content="30 s" Tag="30" />
              <ComboBoxItem Content="45 s" Tag="45" />
              <ComboBoxItem Content="60 s" Tag="60" />
            </ComboBox>
          </Grid>
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource TextTertiary}"
                     Text="默认 20s（本机实测热惯性 5~15s + 余量，与 Tau 16~32s 同量级）。自适应冷却公式属 P1 研究项，本期只做热事件埋点，不实现未验证系数。" />

          <CheckBox x:Name="TakeoverBox" Content="智能模式下允许决策树持续动态微调"
                    Style="{StaticResource Switch}" Margin="0,14,0,0" Click="Toggle_Click" />
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource TextTertiary}"
                     Text="关闭后，选中档位仍立即下发一次，只是决策树不再每拍动态改 PL1。" />
          <CheckBox x:Name="RestoreBox" Content="退出程序时恢复 MSR 原值"
                    Style="{StaticResource Switch}" Margin="0,10,0,0" Click="Toggle_Click" />
          <CheckBox x:Name="TrayBox" Content="关闭窗口时最小化到托盘（采样继续）"
                    Style="{StaticResource Switch}" Margin="0,10,0,0" Click="Toggle_Click" />
          <CheckBox x:Name="StartupBox" Content="开机自动启动（HKCU，无需管理员）"
                    Style="{StaticResource Switch}" Margin="0,10,0,0" Click="Startup_Click" />
          <CheckBox x:Name="RealWriteBox" Content="允许写入 MSR（真实修改功耗，默认关闭）"
                    Style="{StaticResource Switch}" Margin="0,10,0,0" Click="RealWrite_Click" />
          <TextBlock x:Name="MsrStatusLine" Style="{StaticResource Label}" FontSize="11" Margin="0,8,0,0"
                     TextWrapping="Wrap" Foreground="{StaticResource TextTertiary}" />

          <Border Background="{StaticResource BgSubtle}" CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap"
                       Text="1s 采样是热控的推荐值：更慢会漏掉瞬时 PROCHOT，更快对体验没有意义。" />
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="调优模式（单一真值源）" Style="{StaticResource H2}" />
          <TextBlock x:Name="ModeLine" Style="{StaticResource Mono}" FontSize="11" Margin="0,8,0,0"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ModeStatusText, Mode=OneWay}" Style="{StaticResource Label}"
                     FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource TextTertiary}" />
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="智能微调：选中档位立即下发，之后阶梯式低频动态微调。手工微调：参数由手工页保存并下发，智能档位与决策树只演算。两者互斥，切换会二次确认。" />
          <Button x:Name="SwitchModeButton" Content="切回智能微调" Style="{StaticResource GhostButton}"
                  Margin="0,10,0,0" HorizontalAlignment="Left" Click="SwitchMode_Click"
                  Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="数据" Style="{StaticResource H2}" />
          <TextBlock x:Name="DataDirText" Style="{StaticResource Mono}" FontSize="11" Margin="0,10,0,0"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Click="OpenDataDir_Click" />
            <Button Content="重新运行首次向导" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Click="RerunWizard_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="优化参数的持久化" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="固件里的 PL1/PL2 是出厂默认，掉电即恢复、无法持久化。能持久化的只有软件侧的实测标定与手动微调值：每次开机由本软件写回寄存器；软件不运行时 CPU 按固件默认散热逻辑运转。" />
          <CheckBox x:Name="ReplayBox" Content="开机自动重放已保存的微调参数（需管理员 + 写入授权）"
                    Style="{StaticResource Switch}" Margin="0,12,0,0" Click="Toggle_Click" />
          <TextBlock x:Name="SavedTuningText" Style="{StaticResource Mono}" FontSize="11" Margin="0,10,0,0"
                     TextWrapping="Wrap" Foreground="{StaticResource TextTertiary}" />
          <Button Content="清除已保存的微调参数" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                  HorizontalAlignment="Left" Click="ClearTuning_Click" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Grid.Column="1">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="安全与许可" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="本工具涉及内核级硬件访问，分发前必须复核下列组件许可与签名要求。" />

          <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="24" />
              <RowDefinition Height="24" />
              <RowDefinition Height="24" />
              <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <TextBlock Text="LibreHardwareMonitor" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="MPL-2.0 · 允许商用，修改文件需开源" Style="{StaticResource Mono}"
                       FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Text="PawnIO" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="按其发行许可 · 需用户自行安装签名驱动"
                       Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" Text=".NET 8" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="MIT · 框架依赖发布" Style="{StaticResource Mono}"
                       FontSize="11" VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Text="代码签名" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="未签名（发布前需证书，否则易被 Defender 拦截）"
                       Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="关于" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="ThermalTuner · 决策树驱动的 CPU 热约束调优。实测标定与手动微调值保存在本机，开机后重放到寄存器；固件默认值不可持久化，退出恢复原值。" />
          <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="0,10,0,0"
                     Foreground="{StaticResource TextTertiary}" Text="v0.5.1 · net8.0-windows · WPF" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
