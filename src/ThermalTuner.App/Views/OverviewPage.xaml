<UserControl x:Class="ThermalTuner.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThermalTuner.App.Controls"
             Background="Transparent">

  <!-- 概览 = 唯一监控主视图。外层滚动由 MainWindow 统一提供，本页不再嵌套。 -->
  <StackPanel>

    <!-- ============ 全局模式 / 写入状态条 ============ -->
    <Border Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Chip}" Margin="0" VerticalAlignment="Center"
                Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}">
          <TextBlock Text="{Binding TuningModeText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="11" Foreground="{StaticResource AccentDeep}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding ModeStatusText, Mode=OneWay}" Style="{StaticResource Label}"
                     FontSize="11" TextWrapping="Wrap" ToolTip="{Binding MonitorHintText, Mode=OneWay}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding CooldownText, Mode=OneWay}"
                   Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"
                   Foreground="{StaticResource TextTertiary}"
                   ToolTip="升档冷却只约束升档写入；降档与高温降档立即放行。" />
      </Grid>
    </Border>

    <!-- ============ 指标卡（8 项） ============ -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12">
        <StackPanel>
          <TextBlock Text="CPU 封装温度" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding TempText, Mode=OneWay}" />
            <TextBlock Text=" °C" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
          </StackPanel>
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0">
            <Run Text="天花板 " /><Run Text="{Binding CeilingText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,12"
              ToolTip="算法给出的目标功耗，不是寄存器当前值；实际写入由写入闸门与阶梯调度器决定。">
        <StackPanel>
          <TextBlock Text="目标功耗（算法给出）" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding Pl1Text, Mode=OneWay}" />
            <TextBlock Text=" W" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
          </StackPanel>
          <TextBlock Text="{Binding FirmwarePl1Caption, Mode=OneWay}" Style="{StaticResource Label}"
                     FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,12">
        <StackPanel>
          <TextBlock Text="{Binding PowerCaption, Mode=OneWay}" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding PowerText, Mode=OneWay}" />
            <TextBlock Text=" W" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
          </StackPanel>
          <TextBlock Text="{Binding PowerSourceText, Mode=OneWay}" Style="{StaticResource Label}"
                     FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding PowerSourceText, Mode=OneWay}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="最高核频" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding ClockText, Mode=OneWay}" />
            <TextBlock Text=" GHz" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
          </StackPanel>
          <TextBlock Text="传感器实测" Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0"
              ToolTip="{Binding CpuLoadHintText, Mode=OneWay}">
        <StackPanel>
          <TextBlock Text="CPU 负载" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding CpuLoadText, Mode=OneWay}" />
          </StackPanel>
          <ProgressBar Height="3" Margin="0,10,0,0" Maximum="100" Value="{Binding LoadBar, Mode=OneWay}"
                       Foreground="{StaticResource Accent}" Background="{StaticResource BgSubtle}" BorderThickness="0" />
          <TextBlock Text="系统计时 · 与任务管理器同口径" Style="{StaticResource Label}"
                     FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0"
              ToolTip="{Binding GpuHintText, Mode=OneWay}">
        <StackPanel>
          <TextBlock Text="GPU 负载" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding GpuLoadText, Mode=OneWay}" />
          </StackPanel>
          <TextBlock Text="{Binding GpuCardSubtitleText, Mode=OneWay}" Style="{StaticResource Label}"
                     FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0"
              ToolTip="{Binding GpuMemoryHintText, Mode=OneWay}">
        <StackPanel>
          <TextBlock Text="GPU 专用显存占用" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding GpuMemoryText, Mode=OneWay}" />
          </StackPanel>
          <TextBlock Text="{Binding GpuMemoryDetailText, Mode=OneWay}" Style="{StaticResource Label}"
                     FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource Card}"
              ToolTip="{Binding FanDetailText, Mode=OneWay}">
        <StackPanel>
          <TextBlock Text="风扇档位（EC 只读）" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding FanMeasuredText, Mode=OneWay}"
                       Foreground="{StaticResource Accent}" />
          </StackPanel>
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{Binding FanHintBrush, Mode=OneWay}">
            <Run Text="EC 原始值 " /><Run Text="{Binding FanRawText, Mode=OneWay}" />
            <Run Text=" · " /><Run Text="{Binding FanMeasuredHintText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============ 统一时序图 ============ -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <Grid>
          <TextBlock Text="统一时序图" Style="{StaticResource H2}" />
          <TextBlock Text="{Binding HistoryCaptionText, Mode=OneWay}" Style="{StaticResource Mono}"
                     FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Foreground="{StaticResource TextTertiary}" />
        </Grid>
        <TextBlock Text="{Binding HistoryHintText, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,4,0,0" />

        <controls:MetricChart Height="200" Margin="0,10,0,0"
                             Series="{Binding Metrics}"
                             Threshold="{Binding CeilingC}"
                             ThresholdSeriesKey="temp"
                             ThresholdLabel="{Binding ThresholdLabelText}"
                             StartLabel="{Binding HistoryStartText}" />

        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,10,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" Margin="0,0,16,4"
                        ToolTip="{Binding Tooltip}" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Border Width="12" Height="3" Background="{Binding Stroke}"
                          VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"
                             Foreground="{StaticResource TextSecondary}" />
                  <TextBlock Text="{Binding CurrentText}" Style="{StaticResource Mono}" FontSize="11"
                             Margin="5,0,0,0" VerticalAlignment="Center"
                             Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ============ 决策凭证 + 决策流水 ============ -->
    <Grid Margin="0,12,0,0" Height="268">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="最新决策凭证" Style="{StaticResource H2}" />

          <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                  HorizontalAlignment="Left">
            <TextBlock Text="{Binding LastRule, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentDeep}" />
          </Border>

          <TextBlock Text="{Binding LastReason, Mode=OneWay}" Style="{StaticResource Body}"
                     Margin="0,10,0,0" MaxHeight="60" />

          <TextBlock Text="评估路径" Style="{StaticResource Label}" Margin="0,10,0,4" />
          <TextBlock Text="{Binding LastPath, Mode=OneWay}" Style="{StaticResource Mono}"
                     TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="目标功耗" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource TextPrimary}">
                <Run Text="{Binding Pl1Text, Mode=OneWay}" /><Run Text=" W" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="短时上限" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource TextPrimary}">
                <Run Text="{Binding Pl2Text, Mode=OneWay}" /><Run Text=" W" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="短时时长" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource TextPrimary}">
                <Run Text="{Binding TauText, Mode=OneWay}" /><Run Text=" s" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="3">
              <TextBlock Text="能效偏好" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource TextPrimary}"
                         Text="{Binding EppText, Mode=OneWay}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="决策流水" Style="{StaticResource H2}" />
          <Grid DockPanel.Dock="Top" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="118" />
              <ColumnDefinition Width="64" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="时间" Style="{StaticResource Label}" FontSize="11" />
            <TextBlock Grid.Column="1" Text="命中规则" Style="{StaticResource Label}" FontSize="11" />
            <TextBlock Grid.Column="2" Text="目标功耗" Style="{StaticResource Label}" FontSize="11" />
            <TextBlock Grid.Column="3" Text="原因" Style="{StaticResource Label}" FontSize="11" />
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Decisions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" FontSize="11"
                                 VerticalAlignment="Top" />
                      <TextBlock Grid.Column="1" Text="{Binding Rule}" Style="{StaticResource RowText}"
                                 FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentDeep}"
                                 TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding Pl1}" Style="{StaticResource Mono}" FontSize="11"
                                 VerticalAlignment="Top" />
                      <TextBlock Grid.Column="3" Text="{Binding Reason}" Style="{StaticResource RowText}"
                                 FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ============ 运行控制 ============ -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="{Binding RunButtonText, Mode=OneWay}"
                Style="{StaticResource PrimaryButton}" Click="ToggleRun_Click" MinWidth="96" />
        <CheckBox Grid.Column="1" x:Name="StressBox" Content="施加压测负载" Style="{StaticResource Switch}"
                  Margin="16,0,0,0" VerticalAlignment="Center"
                  Checked="Stress_Checked" Unchecked="Stress_Unchecked" />
        <ComboBox Grid.Column="2" x:Name="KernelBox" Width="136" Height="28" Margin="12,0,0,0"
                  VerticalContentAlignment="Center" SelectionChanged="Kernel_Changed" SelectedIndex="2"
                  ToolTip="压测负载类型：SIMD/FMA 最容易顶到功耗墙，内存带宽与脉冲更接近日常负载。">
          <ComboBoxItem Content="整数 ALU" Tag="ScalarInt" />
          <ComboBoxItem Content="标量浮点" Tag="ScalarFloat" />
          <ComboBoxItem Content="SIMD/FMA（最重）" Tag="SimdFma" />
          <ComboBoxItem Content="内存带宽" Tag="MemoryStream" />
          <ComboBoxItem Content="混合轮换" Tag="Mixed" />
          <ComboBoxItem Content="占空比脉冲" Tag="Pulse" />
        </ComboBox>
        <ComboBox Grid.Column="3" x:Name="IntervalBox" Width="92" Height="28" Margin="12,0,0,0"
                  VerticalContentAlignment="Center" SelectionChanged="Interval_Changed"
                  ToolTip="采样间隔：1s 为热控推荐值，更慢会漏掉瞬时高温。">
          <ComboBoxItem Content="500 ms" Tag="500" />
          <ComboBoxItem Content="1000 ms" Tag="1000" IsSelected="True" />
          <ComboBoxItem Content="2000 ms" Tag="2000" />
        </ComboBox>
        <TextBlock Grid.Column="4" x:Name="CountText" Style="{StaticResource Label}" Margin="14,0,0,0"
                   VerticalAlignment="Center" />
        <Button Grid.Column="5" Content="导出 CSV" Style="{StaticResource GhostButton}" Click="Export_Click" />
      </Grid>
    </Border>

    <!-- ============ 采样明细 ============ -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Height="240">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="采样明细（最新在上）" Style="{StaticResource H2}" />

        <Grid DockPanel.Dock="Top" Margin="0,8,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="时间" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="1" Text="温度" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="2" Text="负载" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="3" Text="包功耗" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="4" Text="功耗实效" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="5" Text="风扇" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="6" Text="命中规则" Style="{StaticResource Label}" FontSize="11" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Samples}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,5">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding Temp}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="{Binding Load}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="{Binding Power}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="4" Text="{Binding Pl1}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="5" Text="{Binding Fan}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="6" Text="{Binding Rule}" Style="{StaticResource RowText}" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </StackPanel>
</UserControl>
