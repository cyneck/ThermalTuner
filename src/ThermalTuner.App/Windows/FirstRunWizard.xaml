<Window x:Class="ThermalTuner.App.Windows.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThermalTuner · 首次设置" Width="760" Height="580"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgCanvas}" FontFamily="{StaticResource UiFont}">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="四步完成设置" Style="{StaticResource H1}" />
      <TextBlock x:Name="StepTitle" Style="{StaticResource Label}" Margin="0,4,0,0" Text="第 1 / 4 步 · 识别设备" />
    </StackPanel>

    <ProgressBar Grid.Row="1" Height="3" Margin="0,12,0,0" Maximum="4" Value="1"
                 x:Name="StepBar" Foreground="{StaticResource Accent}"
                 Background="{StaticResource Border}" BorderThickness="0" />

    <!-- 内容 -->
    <Grid Grid.Row="2" Margin="0,16,0,0">

      <!-- 步骤 1 -->
      <Border x:Name="Panel0" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="已识别你的 CPU" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Label}" Margin="0,4,0,14" TextWrapping="Wrap"
                     Text="换任意机器都不需要改代码：探测结果决定后续所有参数范围。" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="1" Text="平台" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center">
              <Run Text="{Binding PlatformText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FormText, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Grid.Row="2" Text="核心" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CoreText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Text="温度上限" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TjMaxText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="4" Text="功耗区间" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PlRangeText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />
          </Grid>

          <Border Background="{StaticResource BgSubtle}" CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap"
                       Text="未识别平台会回退到保守基线（Intel 7 代区间），仍可正常使用，只是上限偏保守。" />
          </Border>
        </StackPanel>
      </Border>

      <!-- 步骤 2 -->
      <Border x:Name="Panel1" Style="{StaticResource Card}" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="权限与驱动" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Label}" Margin="0,4,0,14" TextWrapping="Wrap"
                     Text="读取 CPU 封装温度需要签名驱动 PawnIO + 管理员权限。缺失不会崩溃，只会降级为负载监控。" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <TextBlock Text="硬件驱动" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DriverText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="运行权限" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElevationText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Text="传感器" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center">
              <Run Text="{Binding SensorCount, Mode=OneWay}" /><Run Text=" 个" />
            </TextBlock>
          </Grid>

          <Border x:Name="DriverHint" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}"
                  BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap"
                       Text="未检测到温度传感器：请安装 PawnIO（github.com/namazso/PawnIO/releases），然后关闭本程序并以管理员身份重新运行。也可先跳过，仅使用负载监控。" />
          </Border>
        </StackPanel>
      </Border>

      <!-- 步骤 3 -->
      <Border x:Name="Panel2" Style="{StaticResource Card}" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="基线测量（约 1–3 分钟，可跳过）" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Label}" Margin="0,4,0,14" TextWrapping="Wrap"
                     Text="先用空载 12 秒记录基线，再以全核 SIMD/FMA 高功耗场景升温到温度平台，实测本机稳态热阻（ΔT/ΔP），之后才能预测「再升一档会不会超标」。风扇可能变响，由 EC 按温度自动调速，属正常现象。" />

          <ProgressBar Height="6" Maximum="100" Value="{Binding CalibrationProgress, Mode=OneWay}"
                       Foreground="{StaticResource Accent}" Background="{StaticResource BgSubtle}"
                       BorderThickness="0" />

          <TextBlock Text="{Binding CalibrationText, Mode=OneWay}" Style="{StaticResource Label}"
                     Margin="0,10,0,0" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="开始标定" Style="{StaticResource PrimaryButton}" Click="Calibrate_Click"
                    IsEnabled="{Binding CanCalibrate, Mode=OneWay}"
                    ToolTip="{Binding CalibrationBlockedReason, Mode=OneWay}" />
            <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="也可以稍后在「智能调优」页执行。" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 步骤 4 -->
      <Border x:Name="Panel3" Style="{StaticResource Card}" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="推荐档位" Style="{StaticResource H2}" />
          <TextBlock x:Name="RecommendText" Style="{StaticResource Label}" Margin="0,4,0,14" TextWrapping="Wrap"
                     Text="根据本机探测结果给出建议，可随时在「智能调优」页更改。" />

          <UniformGrid Columns="3">
            <RadioButton x:Name="RadioSilent" Style="{StaticResource ModeCard}" GroupName="wiz" Tag="silent"
                         Margin="0,0,8,0" Checked="Mode_Checked">
              <StackPanel>
                <TextBlock Text="静音优先" Style="{StaticResource H2}" />
                <TextBlock Text="85°C 天花板" Style="{StaticResource Mono}" FontSize="11" Margin="0,6,0,0" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="RadioBalanced" Style="{StaticResource ModeCard}" GroupName="wiz" Tag="balanced"
                         Margin="0,0,8,0" Checked="Mode_Checked">
              <StackPanel>
                <TextBlock Text="均衡" Style="{StaticResource H2}" />
                <TextBlock Text="88°C 天花板" Style="{StaticResource Mono}" FontSize="11" Margin="0,6,0,0" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="RadioPerformance" Style="{StaticResource ModeCard}" GroupName="wiz" Tag="performance"
                         Checked="Mode_Checked">
              <StackPanel>
                <TextBlock Text="性能优先" Style="{StaticResource H2}" />
                <TextBlock Text="92°C 天花板" Style="{StaticResource Mono}" FontSize="11" Margin="0,6,0,0" />
              </StackPanel>
            </RadioButton>
          </UniformGrid>

          <CheckBox x:Name="AutoBox" Style="{StaticResource Switch}" Margin="0,18,0,0" IsChecked="True"
                    Content="验证通过后自动接管功耗参数（不再每次询问）" />

          <Border Background="{StaticResource BgSubtle}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap"
                       Text="自动接管只在你确认后生效；随时可在设置页关闭。写入硬件还需管理员权限与设置页「允许写入 MSR」授权。" />
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 底部 -->
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Button Content="跳过设置" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
              Click="Skip_Click" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BackButton" Content="上一步" Style="{StaticResource GhostButton}"
                MinWidth="88" IsEnabled="False" Click="Back_Click" />
        <Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryButton}"
                MinWidth="104" Margin="8,0,0,0" Click="Next_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
