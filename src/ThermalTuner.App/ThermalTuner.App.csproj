<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ThermalTuner.App</RootNamespace>
    <AssemblyName>ThermalTuner.App</AssemblyName>
    <!-- 统一版本口径：与 README、侧栏版本号一致 -->
    <Version>0.5.3</Version>
    <!-- 可执行文件的运行图标（任务栏 / 资源管理器），同时作为窗口与托盘图标来源 -->
    <ApplicationIcon>Assets\ThermalTuner.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF 依赖 manifest 的 per-monitor DPI；WinForms 分析器建议改用项目属性，此处保留并抑制提示 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 只为托盘图标，排除其隐式 using，避免 MessageBox/Application 与 WPF 冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThermalTuner.Core\ThermalTuner.Core.csproj" />
  </ItemGroup>

  <!-- 打包为 WPF Resource，供窗口 Icon 与托盘 pack:// 读取；单文件发布时同样内嵌 -->
  <ItemGroup>
    <Resource Include="Assets\ThermalTuner.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- LHM 仅用于**传感器采样**（温度 / 功耗 / 频率 / GPU）。
         MSR 读写不经过 LHM：走 PawnIO 直连 IOCTL（见 Services/Msr/PawnIoDevice.cs）。
         版本必须 0.9.6+：后端为 PawnIO，与本项目共用同一驱动；升级前需跑写入自检验证写链路。 -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <!-- PawnIO 已签名模块（PawnIO.Modules 0.2.11，LGPL-2.1）。
       随产品分发时必须附带 COPYING（见 Assets/PawnIO/README.txt 的源码获取方式）。
       加载时由驱动做签名校验，模块内部再按白名单限制可写的 MSR。 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\PawnIO\IntelMSR.bin">
      <LogicalName>ThermalTuner.App.Assets.PawnIO.IntelMSR.bin</LogicalName>
    </EmbeddedResource>
    <!-- PawnIO 内核驱动包（微软 WHQL 签名）：用于首次安装时自管释放与注册。
         三件套必须同时存在，pawnsio.inf 引用了 .sys 与 .cat。 -->
    <EmbeddedResource Include="Assets\PawnIO\driver\pawnio.inf">
      <LogicalName>ThermalTuner.App.Assets.PawnIO.driver.pawnio.inf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\PawnIO\driver\PawnIO.sys">
      <LogicalName>ThermalTuner.App.Assets.PawnIO.driver.PawnIO.sys</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\PawnIO\driver\PawnIO.cat">
      <LogicalName>ThermalTuner.App.Assets.PawnIO.driver.PawnIO.cat</LogicalName>
    </EmbeddedResource>
    <None Include="Assets\PawnIO\COPYING.LESSER.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\PawnIO\README.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
