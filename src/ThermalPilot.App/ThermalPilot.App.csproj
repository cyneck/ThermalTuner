<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ThermalPilot.App</RootNamespace>
    <AssemblyName>ThermalPilot.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF 依赖 manifest 的 per-monitor DPI；WinForms 分析器建议改用项目属性，此处保留并抑制提示 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 只为托盘图标，排除其隐式 using，避免 MessageBox/Application 与 WPF 冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThermalPilot.Core\ThermalPilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0.9.4 自带 WinRing0 内核驱动，提供 Ring0.WriteMsr（可读写 MSR）。
         0.9.6 起 LHM 把后端换为 PawnIO，且随包 IntelMSR 模块只有 ioctl_read_msr（只读），
         会导致 0x610 写入能力丢失。本项目需要真实下发 PL1/PL2/EPP，故固定 0.9.4。 -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <!-- v0.4.2 误升级 0.9.6+ 时留下的 PawnIO 适配，零调用点、只读、未启用。
       运行时只用 LHM 0.9.4 / WinRing0；保留文件作历史参考，不参与编译。 -->
  <ItemGroup>
    <Compile Remove="Services/Msr/PawnIoNative.cs" />
    <Compile Remove="Services/Msr/LhmPawnModule.cs" />
  </ItemGroup>

</Project>
