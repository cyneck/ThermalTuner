<?xml version="1.0" encoding="utf-8"?>
<!--
  设计令牌（Design Tokens）
  - 唯一强调色：墨青 #2E6F5F
  - 1px 描边替代阴影
  - 8px 栅格
  - 数字统一等宽（Consolas）便于纵向对齐
  研发改视觉只改这一个文件。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ========== 颜色 ========== -->
  <SolidColorBrush x:Key="BgCanvas"     Color="#F6F7F7" />
  <SolidColorBrush x:Key="BgSurface"    Color="#FFFFFF" />
  <SolidColorBrush x:Key="BgSubtle"     Color="#F1F3F2" />
  <SolidColorBrush x:Key="Border"       Color="#E3E6E4" />
  <SolidColorBrush x:Key="BorderStrong" Color="#CFD6D2" />

  <SolidColorBrush x:Key="TextPrimary"   Color="#1B2321" />
  <SolidColorBrush x:Key="TextSecondary" Color="#5F6E69" />
  <SolidColorBrush x:Key="TextTertiary"  Color="#8C9A95" />

  <SolidColorBrush x:Key="Accent"      Color="#2E6F5F" />
  <SolidColorBrush x:Key="AccentDeep"  Color="#245A4C" />
  <SolidColorBrush x:Key="AccentSoft"  Color="#E8F0ED" />

  <SolidColorBrush x:Key="Warn"     Color="#A9702A" />
  <SolidColorBrush x:Key="WarnSoft" Color="#FBF2E4" />
  <SolidColorBrush x:Key="Danger"     Color="#B0453C" />
  <SolidColorBrush x:Key="DangerSoft" Color="#FBEAE8" />

  <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>

  <!-- ========== 文本 ========== -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>

  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>

  <Style x:Key="Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <!-- ========== 容器 ========== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <!-- ========== 按钮 ========== -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                  BorderBrush="{StaticResource AccentDeep}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDeep}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSubtle}" />
              <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Border}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource BgSurface}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                  BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSubtle}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== 导航 ========== -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Height" Value="38" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="bg" Background="Transparent" CornerRadius="6" Margin="8,2" />
            <Border x:Name="bar" Width="3" Height="18" Margin="0,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="Transparent" CornerRadius="0,2,2,0" />
            <ContentPresenter Margin="24,0,12,0" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{StaticResource BgSubtle}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentSoft}" />
              <Setter TargetName="bar" Property="Background" Value="{StaticResource Accent}" />
              <Setter Property="Foreground" Value="{StaticResource AccentDeep}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== 档位卡 ========== -->
  <Style x:Key="ModeCard" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="{StaticResource BgSurface}"
                  BorderBrush="{StaticResource Border}" BorderThickness="1"
                  CornerRadius="8" Padding="16">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== 输入 ========== -->
  <Style x:Key="FieldBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSubtle}" />
              <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- 表格行 -->
  <Style x:Key="RowText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

</ResourceDictionary>
