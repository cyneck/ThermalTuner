<UserControl x:Class="ThermalPilot.App.Views.TuningPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.5*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左：意图表达 -->
    <StackPanel Grid.Column="0" Margin="0,0,12,0">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="使用档位" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Label}" Margin="0,4,0,12"
                     Text="档位只是意图，具体 PL1 由决策树按温度与热阻动态给出；风扇由 EC 按温度曲线自动调速，软件不直接控制转速。" />

          <UniformGrid Columns="3">
            <RadioButton Style="{StaticResource ModeCard}" GroupName="mode" Tag="silent"
                         IsChecked="{Binding IsSilent, Mode=OneWay}" Click="Mode_Click" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="静音优先" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0" FontSize="11">
                  <Run Text="天花板 85°C · 最保守" />
                </TextBlock>
                <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0"
                           Text="适合办公、夜间" TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModeCard}" GroupName="mode" Tag="balanced"
                         IsChecked="{Binding IsBalanced, Mode=OneWay}" Click="Mode_Click" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="均衡" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0" FontSize="11">
                  <Run Text="天花板 88°C · 折中" />
                </TextBlock>
                <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0"
                           Text="默认推荐" TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModeCard}" GroupName="mode" Tag="performance"
                         IsChecked="{Binding IsPerformance, Mode=OneWay}" Click="Mode_Click">
              <StackPanel>
                <TextBlock Text="性能优先" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0" FontSize="11">
                  <Run Text="天花板 92°C · 最激进" />
                </TextBlock>
                <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0"
                           Text="适合编译、渲染" TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <Grid>
            <TextBlock Text="温度天花板" Style="{StaticResource H2}" />
            <TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Right"
                       FontSize="16" Foreground="{StaticResource Accent}"
                       Text="{Binding CeilingText, Mode=OneWay}" />
          </Grid>

          <Slider x:Name="CeilingSlider" Margin="0,12,0,0" Minimum="40" Maximum="95"
                  TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding CeilingC, Mode=OneWay}"
                  ValueChanged="Ceiling_ValueChanged" />

          <Grid Margin="0,2,0,0">
            <TextBlock Text="40°C" Style="{StaticResource Label}" FontSize="11" />
            <TextBlock Style="{StaticResource Label}" FontSize="11" HorizontalAlignment="Right">
              <Run Text="安全上限 " /><Run Text="{Binding Limits.MaxSafeCeiling, Mode=OneWay, StringFormat={}{0:F0}}" /><Run Text="°C" />
            </TextBlock>
          </Grid>

          <Border Background="{StaticResource BgSubtle}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap">
              <Run Text="天花板决定「多热才降功耗」。调低 → 更凉更安静；调高 → 更久保持高频，但更接近 " />
              <Run Text="{Binding Limits.TjMax, Mode=OneWay, StringFormat={}{0:F0}}" />
              <Run Text="°C 硬件保护点。" />
            </TextBlock>
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="平台约束（自动探测）" Style="{StaticResource H2}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="24" />
              <RowDefinition Height="24" />
              <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource Mono}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="平台" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center">
              <Run Text="{Binding PlatformText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FormText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="2" Text="功耗区间" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PlRangeText}" Style="{StaticResource Mono}"
                       VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 右：热模型与标定 -->
    <StackPanel Grid.Column="1">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="在线热模型" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Label}" Margin="0,4,0,12" TextWrapping="Wrap"
                     Text="用真实温度与功耗拟合热阻，预测稳态温度；标定值还会按天花板钳制决策 PL1 上限，参与每拍决策。" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="估计热阻" Style="{StaticResource Label}" FontSize="11" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding RthText, Mode=OneWay}" Style="{StaticResource Metric}" FontSize="22" />
                <TextBlock Text=" K/W" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,3" />
              </StackPanel>
              <TextBlock Text="{Binding RthSourceText, Mode=OneWay}" Style="{StaticResource Label}"
                         FontSize="11" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1">
              <TextBlock Text="预测稳态" Style="{StaticResource Label}" FontSize="11" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding PredictedText, Mode=OneWay}" Style="{StaticResource Metric}" FontSize="22" />
                <TextBlock Text=" °C" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,3" />
              </StackPanel>
              <TextBlock Text="{Binding PredictedBasisText, Mode=OneWay}" Style="{StaticResource Label}"
                         FontSize="11" Margin="0,2,0,0" />
              <TextBlock Text="{Binding PredictedBaselineText, Mode=OneWay}" Style="{StaticResource Label}"
                         FontSize="10" Margin="0,1,0,0" Foreground="{StaticResource TextTertiary}" />
            </StackPanel>
          </Grid>

          <Border Background="{StaticResource BgSubtle}" CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="{Binding ThermalCapText, Mode=OneWay}" Style="{StaticResource Label}"
                         FontSize="11" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TextTertiary}"
                         Text="预测式：基线温度 +（目标功耗 − 基线功耗）× 热阻；基线取最近一次轻载稳态样本，可与卡片数值手工复算。" />
              <TextBlock Text="{Binding CalibrationSummaryText, Mode=OneWay}" Style="{StaticResource Label}"
                         FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TextTertiary}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="一键标定" Style="{StaticResource H2}" />
          <TextBlock Text="{Binding CalibrationText, Mode=OneWay}" Style="{StaticResource Label}"
                     Margin="0,4,0,10" TextWrapping="Wrap" />

          <ProgressBar Height="4" Maximum="100" Value="{Binding CalibrationProgress, Mode=OneWay}"
                       Foreground="{StaticResource Accent}" Background="{StaticResource BgSubtle}"
                       BorderThickness="0" Margin="0,0,0,12" />

          <StackPanel Orientation="Horizontal">
            <Button x:Name="CalibrateButton" Content="开始两段式标定" Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanCalibrate, Mode=OneWay}"
                    ToolTip="{Binding CalibrationBlockedReason, Mode=OneWay}"
                    Click="Calibrate_Click" />
            <Button Content="取消" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Click="CancelCalibration_Click" />
            <Button Content="以管理员重启" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Visibility="{Binding ElevationHintVisibility, Mode=OneWay}"
                    ToolTip="读取真实功耗与 MSR 需要管理员权限"
                    Click="RestartElevated_Click" />
          </StackPanel>

          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="12 秒空载基线 → 全核 SIMD/FMA 高功耗场景升温至温度平台 → 10 秒稳态采样，全程 1–3 分钟（视散热条件）；风扇可能变响，由 EC 按温度自动调速，软件不直控。按钮置灰时悬停可看缺少哪项读数。" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="当前决策参数" Style="{StaticResource H2}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
              <TextBlock Text="决策 PL1" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="13">
                <Run Text="{Binding Pl1Text, Mode=OneWay}" /><Run Text=" W" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1">
              <TextBlock Text="PL2" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="13">
                <Run Text="{Binding Pl2Text, Mode=OneWay}" /><Run Text=" W" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
              <TextBlock Text="Tau" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="13">
                <Run Text="{Binding TauText, Mode=OneWay}" /><Run Text=" s" />
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
              <TextBlock Text="EPP" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Text="{Binding EppText, Mode=OneWay}" Style="{StaticResource Mono}" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
              <TextBlock Text="风扇演算值（未下发）" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="13">
                <Run Text="{Binding FanText, Mode=OneWay}" /><Run Text=" %" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
              <TextBlock Text="档位" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Text="{Binding ProfileLabel, Mode=OneWay}" Style="{StaticResource Mono}" FontSize="13" />
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="风扇百分比是决策树演算的建议值，未下发到任何硬件；实际转速由 EC 按温度曲线自动调节，软件只能通过降低发热间接影响。" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
