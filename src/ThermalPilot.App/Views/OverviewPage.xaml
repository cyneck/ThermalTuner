<UserControl x:Class="ThermalPilot.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThermalPilot.App.Controls"
             Background="Transparent">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 指标卡 -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="CPU 封装温度" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding TempText, Mode=OneWay}" />
            <TextBlock Text=" °C" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
          </StackPanel>
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0">
            <Run Text="天花板 " /><Run Text="{Binding CeilingText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="系统负载" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding LoadText, Mode=OneWay}" />
            <TextBlock Text=" %" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
          </StackPanel>
          <ProgressBar Height="3" Margin="0,10,0,0" Maximum="100" Value="{Binding LoadBar, Mode=OneWay}"
                       Foreground="{StaticResource Accent}" Background="{StaticResource BgSubtle}" BorderThickness="0" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="决策 PL1（目标）" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding Pl1Text, Mode=OneWay}" />
            <TextBlock Text=" W" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
          </StackPanel>
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0">
            <Run Text="PL2 " /><Run Text="{Binding Pl2Text, Mode=OneWay}" /><Run Text=" W · 仅只读" />
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Grid.Column="3" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{Binding PowerCaption, Mode=OneWay}" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Metric}" Text="{Binding PowerText, Mode=OneWay}" />
            <TextBlock Text=" W" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
          </StackPanel>
          <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0">
            <Run Text="最高核频 " /><Run Text="{Binding ClockText, Mode=OneWay}" /><Run Text=" GHz" />
          </TextBlock>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 双曲线 -->
    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <Grid>
            <TextBlock Text="温度趋势" Style="{StaticResource H2}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Border Width="10" Height="2" Background="{StaticResource Accent}" VerticalAlignment="Center" />
              <TextBlock Text="温度" Style="{StaticResource Label}" FontSize="11" Margin="6,0,12,0" />
              <Border Width="10" Height="1" Background="{StaticResource Danger}" VerticalAlignment="Center" />
              <TextBlock Text="天花板" Style="{StaticResource Label}" FontSize="11" Margin="6,0,0,0" />
            </StackPanel>
          </Grid>
          <controls:SparkChart Height="150" Margin="0,10,0,0"
                               Values="{Binding TempHistory}"
                               Threshold="{Binding CeilingC}"
                               AutoScale="True"
                               Stroke="{StaticResource Accent}"
                               Fill="#1A2E6F5F"
                               ThresholdBrush="{StaticResource Danger}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <TextBlock Text="功耗趋势" Style="{StaticResource H2}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Border Width="10" Height="2" Background="{StaticResource Accent}" VerticalAlignment="Center" />
              <TextBlock Text="决策 PL1" Style="{StaticResource Label}" FontSize="11" Margin="6,0,12,0" />
              <Border Width="10" Height="2" Background="{StaticResource Warn}" VerticalAlignment="Center" />
              <TextBlock Text="实测包功耗" Style="{StaticResource Label}" FontSize="11" Margin="6,0,0,0" />
            </StackPanel>
          </Grid>
          <controls:SparkChart Height="150" Margin="0,10,0,0"
                               Values="{Binding Pl1History}"
                               SecondaryValues="{Binding PowerHistory}"
                               AutoScale="True"
                               Stroke="{StaticResource Accent}"
                               SecondaryStroke="{StaticResource Warn}"
                               Fill="#1A2E6F5F" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 决策凭证 + 流水 -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="最新决策凭证" Style="{StaticResource H2}" />

          <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                  HorizontalAlignment="Left">
            <TextBlock Text="{Binding LastRule, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentDeep}" />
          </Border>

          <TextBlock Text="{Binding LastReason, Mode=OneWay}" Style="{StaticResource Body}"
                     Margin="0,10,0,0" MaxHeight="72" />

          <TextBlock Text="评估路径" Style="{StaticResource Label}" Margin="0,14,0,4" />
          <TextBlock Text="{Binding LastPath, Mode=OneWay}" Style="{StaticResource Mono}"
                     TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="PL1" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource TextPrimary}">
                <Run Text="{Binding Pl1Text, Mode=OneWay}" /><Run Text=" W" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="PL2" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource TextPrimary}">
                <Run Text="{Binding Pl2Text, Mode=OneWay}" /><Run Text=" W" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Tau" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource TextPrimary}">
                <Run Text="{Binding TauText, Mode=OneWay}" /><Run Text=" s" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="3">
              <TextBlock Text="EPP" Style="{StaticResource Label}" FontSize="11" />
              <TextBlock Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource TextPrimary}"
                         Text="{Binding EppText, Mode=OneWay}" />
            </StackPanel>
          </Grid>

          <Border Background="{StaticResource BgSubtle}" CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap"
                       Text="当前为只读监控：决策值仅展示，未写入 MSR。写入通道属 M3 里程碑（含备份 / 回读 / 看门狗）。" />
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="决策流水" Style="{StaticResource H2}" />
          <Grid DockPanel.Dock="Top" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="118" />
              <ColumnDefinition Width="64" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="时间" Style="{StaticResource Label}" FontSize="11" />
            <TextBlock Grid.Column="1" Text="命中规则" Style="{StaticResource Label}" FontSize="11" />
            <TextBlock Grid.Column="2" Text="PL1" Style="{StaticResource Label}" FontSize="11" />
            <TextBlock Grid.Column="3" Text="因果理由" Style="{StaticResource Label}" FontSize="11" />
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Decisions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" FontSize="11"
                                 VerticalAlignment="Top" />
                      <TextBlock Grid.Column="1" Text="{Binding Rule}" Style="{StaticResource RowText}"
                                 FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentDeep}"
                                 TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding Pl1}" Style="{StaticResource Mono}" FontSize="11"
                                 VerticalAlignment="Top" />
                      <TextBlock Grid.Column="3" Text="{Binding Reason}" Style="{StaticResource RowText}"
                                 FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
