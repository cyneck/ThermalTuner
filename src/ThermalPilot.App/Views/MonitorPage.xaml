<UserControl x:Class="ThermalPilot.App.Views.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThermalPilot.App.Controls"
             Background="Transparent">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 工具条 -->
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Content="{Binding RunButtonText, Mode=OneWay}" Style="{StaticResource PrimaryButton}"
                  Click="ToggleRun_Click" MinWidth="96" />
          <CheckBox x:Name="StressBox" Content="施加压测负载" Style="{StaticResource Switch}"
                    Margin="16,0,0,0" VerticalAlignment="Center"
                    Checked="Stress_Checked" Unchecked="Stress_Unchecked" />
          <TextBlock Text="采样间隔" Style="{StaticResource Label}" Margin="20,0,8,0" VerticalAlignment="Center" />
          <ComboBox x:Name="IntervalBox" Width="96" Height="30" VerticalContentAlignment="Center"
                    SelectionChanged="Interval_Changed">
            <ComboBoxItem Content="500 ms" Tag="500" />
            <ComboBoxItem Content="1000 ms" Tag="1000" IsSelected="True" />
            <ComboBoxItem Content="2000 ms" Tag="2000" />
          </ComboBox>
          <TextBlock x:Name="CountText" Style="{StaticResource Label}" Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Button Content="导出 CSV" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                Click="Export_Click" />
      </Grid>
    </Border>

    <!-- 曲线 -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <Grid>
          <TextBlock Text="温度与决策 PL1" Style="{StaticResource H2}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Border Width="10" Height="2" Background="{StaticResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="温度 °C" Style="{StaticResource Label}" FontSize="11" Margin="6,0,12,0" />
            <Border Width="10" Height="2" Background="{StaticResource Warn}" VerticalAlignment="Center" />
            <TextBlock Text="PL1 W" Style="{StaticResource Label}" FontSize="11" Margin="6,0,0,0" />
          </StackPanel>
        </Grid>
        <controls:SparkChart Height="180" Margin="0,10,0,0"
                             Values="{Binding TempHistory}"
                             SecondaryValues="{Binding Pl1History}"
                             Threshold="{Binding CeilingC}"
                             AutoScale="True"
                             Stroke="{StaticResource Accent}"
                             Fill="#1A2E6F5F"
                             SecondaryStroke="{StaticResource Warn}"
                             ThresholdBrush="{StaticResource Danger}" />
      </StackPanel>
    </Border>

    <!-- 明细 -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="采样明细（最新在上）" Style="{StaticResource H2}" />

        <Grid DockPanel.Dock="Top" Margin="0,8,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="时间" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="1" Text="温度" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="2" Text="负载" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="3" Text="包功耗" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="4" Text="PL1 实效" Style="{StaticResource Label}" FontSize="11" />
          <TextBlock Grid.Column="5" Text="命中规则" Style="{StaticResource Label}" FontSize="11" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Samples}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,5">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding Temp}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="{Binding Load}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="{Binding Power}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="4" Text="{Binding Pl1}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Grid.Column="5" Text="{Binding Rule}" Style="{StaticResource RowText}" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
